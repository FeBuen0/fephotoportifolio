# Configure these as server-side secrets in the hosting provider.
# Run npm run admin:credentials in an interactive terminal to provision the only account.
# Never put real values in this file or commit a populated .env file.
FEPHOTOS_ADMIN_USERNAME=
FEPHOTOS_ADMIN_PASSWORD_HASH=
FEPHOTOS_SESSION_SECRET=
# Fine-grained GitHub token restricted to FeBuen0/fephotoportifolio, Contents: read/write.
FEPHOTOS_GITHUB_TOKEN=
